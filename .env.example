# =============================================================================
# Telegram Gateway — единый файл настроек
# =============================================================================

APP_ENV=production

# --- MySQL (внешний) ---
SQL_HOST=your-mysql-host.com
SQL_PORT=3306
SQL_DB=bridge_api_service
SQL_USER=bridge_user
SQL_PASSWORD=change_me_strong_password

# --- Redis (локальный контейнер в docker-compose) ---
REDIS_URL=redis://redis:6379/0

# --- Telegram Gateway ---
TELEGRAM_API_URL=https://api.telegram.org
GATEWAY_PUBLIC_URL=https://your-domain.com

# --- Логирование (3 месяца) ---
LOG_LEVEL=INFO
LOG_FILE=/var/log/telegram-gateway/app.log
LOG_RETENTION_DAYS=90

# --- Rate limiting / timeout ---
RATE_LIMIT=100/minute
REQUEST_TIMEOUT=15

# --- Безопасность ---
ALLOW_HTTP_TARGETS=false

# --- База данных ---
AUTO_CREATE_TABLES=false
