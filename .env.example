# =============================================================================
# Telegram Gateway Configuration
# =============================================================================

APP_ENV=production

# --- MySQL ---
SQL_HOST=your-mysql-host.com
SQL_PORT=3306
SQL_DB=bridge_api_service
SQL_USER=bridge_user
SQL_PASSWORD=change_me_strong_password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Public Gateway URL ---
GATEWAY_PUBLIC_URL=https://your-domain.com

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=/var/log/telegram-gateway/app.log
LOG_RETENTION_DAYS=90

# --- Rate Limiting ---
RATE_LIMIT=100/minute
REQUEST_TIMEOUT=15

# --- Security ---
ALLOW_HTTP_TARGETS=false